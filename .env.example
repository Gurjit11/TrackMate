GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Message dispatch is disabled by default; only a human approval can dispatch.
DELIVERY_MODE=dry_run
COURIER_SUPPORT_EMAIL=
APPROVAL_TOKEN=

# SMTP email delivery (used only when DELIVERY_MODE=live).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Twilio WhatsApp delivery (used only when DELIVERY_MODE=live).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
